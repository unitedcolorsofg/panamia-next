<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android App Links.

              This is the app's half of the claim; the site's half is served
              from app/.well-known/assetlinks.json. BOTH are required and
              neither reports anything when it is missing — the symptom is
              simply that every pana.social link keeps opening in Chrome.

              android:autoVerify="true" is what makes these links open the app
              silently, with no disambiguation dialog: at install time Android
              fetches assetlinks.json over https and checks that it names this
              package and this signing certificate. Without the attribute the
              filter still matches, but the member gets an app chooser every
              time, which is worse than not having deep links at all.

              Both surfaces are listed because they are separate hostnames on
              the same Worker once PANAVERSE_SUBDOMAINS is on, and this one app
              carries both of them (see lib/panaverse/surfaces.ts). Verification
              is per-host, so an unlisted host is an unclaimed host.

              Note the activity above is launchMode="singleTask": a link
              arriving while the app is already open resumes the running
              instance and is delivered to the appUrlOpen listener in
              components/mobile/NativeShell.tsx, rather than starting a second
              copy of the app on top of the first.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pana.social" />
                <data android:scheme="https" android:host="social.pana.social" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Push notifications, Android 13 (API 33) and up.

      Declared here rather than inherited: @capacitor/push-notifications ships
      an Android manifest that registers its messaging service but does not
      declare this permission, so with targetSdkVersion 36 the runtime request
      made by PushNotifications.requestPermissions() has nothing to request.
      It does not throw — it returns "denied" immediately, the dialog never
      appears, and the member has no way to tell that they were never asked.

      Below API 33 notifications need no permission at all and this is ignored,
      which is why minSdkVersion 24 is unaffected.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Permissions for the web APIs the WebView can reach.

      Same failure mode as POST_NOTIFICATIONS above, and the same reason for
      being here: Capacitor's WebChromeClient does handle onPermissionRequest
      and onGeolocationPermissionsShowPrompt, but it can only request a
      permission the app has declared. Undeclared, the runtime request is
      refused immediately — no dialog, no error in the page, just a
      getUserMedia promise that rejects and a geolocation callback that reports
      permission denied. The member has no way to tell they were never asked.

      The shell loads the deployed site, so these are reachable from the app
      exactly as they are in a browser:
        - location    lib/geolocation.ts, components/social/LocationPickerModal,
                      app/p/[user]/_lib/use-viewer-location
        - microphone  components/social/VoiceMemoComposer, app/m session rooms
        - camera      app/m/session/[sessionId] video rooms

      Coarse is listed beside fine because Android 12 and up lets the member
      grant only approximate location, and an app that declares fine alone does
      not offer them that choice.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Declared not-required so the Play Store does not filter the app off
      devices lacking the hardware. A <uses-permission> for CAMERA implies
      <uses-feature android:name="android.hardware.camera" android:required="true">
      unless it is overridden here, which would quietly make the app
      uninstallable on hardware that is otherwise perfectly able to run it —
      video rooms are one feature among many, not the product.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
