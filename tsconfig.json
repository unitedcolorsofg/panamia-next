{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "typeRoots": ["./types"],
    "paths": {
      "@/*": ["./*"],
      "@/config/*": ["./config/*"],
      "@/styles/*": ["./styles/*"],
      "@/components/*": ["./components/*"],
      "@/lib/*": ["./lib/*"],
      "@/app/*": ["./app/*"],
      "@/model/*": ["./api/auth/lib/model/*"],
      "@/federation/*": ["./lib/federation/*"],
      "@/external/*": ["./external/*"],
      "next/server": ["./node_modules/vinext/dist/shims/server"],
      "next/navigation": ["./node_modules/vinext/dist/shims/navigation"],
      "next/link": ["./node_modules/vinext/dist/shims/link"],
      "next/image": ["./node_modules/vinext/dist/shims/image"],
      "next/dynamic": ["./node_modules/vinext/dist/shims/dynamic"],
      "next/headers": ["./node_modules/vinext/dist/shims/headers"],
      "next/cache": ["./node_modules/vinext/dist/shims/cache"],
      "next/head": ["./node_modules/vinext/dist/shims/head"],
      "next/script": ["./node_modules/vinext/dist/shims/script"],
      "next/router": ["./node_modules/vinext/dist/shims/router"],
      "next/og": ["./node_modules/vinext/dist/shims/og"],
      "next/font/google": ["./node_modules/vinext/dist/shims/font-google"],
      "next/font/local": ["./node_modules/vinext/dist/shims/font-local"],
      "next/dist/shared/lib/constants": ["./lib/shims/next-constants"]
      // No bare "next" entry on purpose. vinext turns every paths entry into a
      // Vite alias and Vite string aliases match by PREFIX, so mapping "next"
      // captured every next/* specifier not mapped individually above and
      // rewrote it to a nonexistent lib/shims/next-root/* path. vinext's own
      // shim map resolves those correctly on its own. Types for bare
      // `import ... from 'next'` now come from types/next.d.ts.
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    // Standalone relay operator/diagnostic tools + their test harness. Run via
    // `tsx`, decoupled from the app build/typecheck (they talk to the relay over
    // WebSocket and read RELAY_URL from the shell, not .env.local).
    "scripts/relay-*.ts",
    "tests-relay/**",
    "external/**",
    "worker/**"
  ]
}
